# Streamlit secrets 模板
# 复制为 .streamlit/secrets.toml 后填入真实值
# 注意：secrets.toml 不要提交到 git！

[api]
# ====== 切换后端 ======
# 选项 1：本地模拟后端（无需 GPU，无需模型，演示场景首选）
# url = "http://localhost:8000"
#
# 选项 2：A 同学真模型后端（要求 backend/ 服务在跑）
# url = "http://localhost:8000"  # 同样默认 8000 端口
#
# 选项 3：服务器/远程真模型
# url = "http://your-server-ip:8000"
url = "http://localhost:8000"

# 是否强制使用 mock（true=不连真后端，跳过 GPU 加载）
# 留空或 false：按 url 自动连
# force_mock = true
